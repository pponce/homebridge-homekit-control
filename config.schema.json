{
  "pluginAlias": "HomekitControl",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "services": {
        "type": "array",
        "items": {
          "title": "Device",
          "type": "object",
          "properties": {
            "uniquePrefix": {
              "title": "Prefix",
              "type": "string",
              "required": false,
              "description": "Optional namespace when the same device is used by multiple Homebridge instances. Keep it unchanged after pairing."
            },
            "name": {
              "title": "Name",
              "type": "string",
              "required": false,
              "placeholder": "Enter a Custom Name",
              "description": "Display name. Renaming after migration keeps the accessory identity."
            },
            "logFoundServices": {
              "title": "Log service structure",
              "type": "boolean",
              "required": false,
              "default": false,
              "description": "Log service types and IDs without characteristic values or pairing credentials."
            },
            "proxyAll": {
              "title": "Proxy All",
              "type": "boolean",
              "required": false,
              "default": false,
              "description": "When enabled, we will Proxy everything from connected clients. This does not filter any requests and may is of course untested for unkwnown services but it will enable devices that are not yet manually configured"
            },
            "enableHistory": {
              "title": "Enable History",
              "type": "boolean",
              "required": false,
              "default": false,
              "description": "Enables FakeGato for compatible Devices. This will enable the History Display in the EVE-App."
            },
            "historyInterval": {
              "title": "History interval (seconds)",
              "type": "integer",
              "required": false,
              "default": 600,
              "description": "Interval between measurements for the History Service (in Seconds)",
              "minimum": 30,
              "maximum": 600
            },
            "id": {
              "title": "Accessory ID",
              "type": "string",
              "required": true,
              "placeholder": "id"
            },
            "address": {
              "title": "Device IP",
              "type": "string",
              "required": true,
              "placeholder": "address"
            },
            "port": {
              "title": "Device Port",
              "type": "integer",
              "required": true,
              "placeholder": "port"
            },
            "pairingData": {
              "title": "Pairing Credentials",
              "type": "object",
              "properties": {
                "AccessoryPairingID": {
                  "title": "Accessory Pairing ID",
                  "type": "string",
                  "required": false,
                  "placeholder": "pairingData.AccessoryPairingID"
                },
                "AccessoryLTPK": {
                  "title": "Accessory LTPK",
                  "type": "string",
                  "required": false,
                  "placeholder": "pairingData.AccessoryLTPK"
                },
                "iOSDevicePairingID": {
                  "title": "iOS Pairing ID",
                  "type": "string",
                  "required": false,
                  "placeholder": "pairingData.iOSDevicePairingID"
                },
                "iOSDeviceLTSK": {
                  "title": "iOS Pairing LTSK",
                  "type": "string",
                  "required": false,
                  "placeholder": "pairingData.iOSDeviceLTSK"
                },
                "iOSDeviceLTPK": {
                  "title": "iOS Pairing LTPK",
                  "type": "string",
                  "required": false,
                  "placeholder": "pairingData.iOSDeviceLTPK"
                }
              },
              "description": "Legacy manual credentials. Newly paired devices use the private pairing store; leave this empty."
            },
            "legacyName": {
              "title": "Previous configured name (migration only)",
              "type": "string",
              "description": "Only needed if renaming an accessory before the first restart with this version. Leave empty for new devices."
            }
          }
        }
      }
    }
  },
  "customUi": true
}
